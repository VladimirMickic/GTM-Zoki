{
  "autoMode": {
    "allow": ["$defaults", "Bash(python -m gtm.run output *)"]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./credentials/**)"
    ],
    "allow": [
      "Bash(apify info*)",
      "Bash(python -m gtm.run*)",
      "Bash(.venv/bin/python -m gtm.run*)",
      "Bash(python -m pytest*)",
      "Bash(.venv/bin/python -m pytest*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret_guard.py\""
          }
        ]
      }
    ]
  }
}
