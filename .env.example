# Copy to .env and fill in. Never commit .env — it is gitignored and a pre-commit hook
# scans for keys. Only the first two are required; every other key is optional and its
# absence skips that provider rather than failing the run.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=
SERPER_API_KEY=

# --- Google Sheet push (stage 8) ------------------------------------------
# Also needs credentials/service_account.json, and the Sheet must be shared with
# that service account's email address. GTM_SHEET_KEY is the id in the Sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GTM_SHEET_KEY=

# --- HubSpot upsert (optional) --------------------------------------------
# Private-app access token. Absent = HubSpot push is skipped entirely.
HUBSPOT_SERVICE_KEY=

# --- Scraper fallbacks (optional) -----------------------------------------
# crawl4ai is the default and needs no key. These back it up in order:
# Firecrawl -> ScrapeGraphAI -> Apify. Apify uses the `apify` CLI, not a key here.
FIRECRAWL_API_KEY=
SCRAPEGRAPHAI_API_KEY=
APIFY_TIMEOUT_SECONDS=180

# --- Email find/verify waterfall (optional) -------------------------------
# Tried in order; the run falls back to pattern guesses if all are absent.
MYEMAILVERIFIER_API_KEY=
ABSTRACT_API_KEY=
PROSPEO_API_KEY=
HUNTER_API_KEY=
GETPROSPECT_API_KEY=
